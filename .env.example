# docker-compose 环境变量样例
#
# 用法:  cp .env.example .env  并按需修改
#        .env 不要提交到 git
#
# 这些变量同时被两条链路读取:
#   1. docker compose build  — 本地构建 (开发平台执行)
#   2. docker stack deploy    — 由上游开发平台替换 HARBOR_HOST / PROJECT_NAME / TAG

# ===== 镜像仓库 / 项目标识 =====
# 开发平台部署时会注入实际值；本地构建时可保持默认
HARBOR_HOST=harbor.example
PROJECT_NAME=common
TAG=latest

# ===== MySQL =====
MYSQL_IMAGE=mysql:8.0
DB_NAME=common
DB_USERNAME=root
DB_PASSWORD=123456

# ===== 后端 (Spring Boot) JVM =====
JAVA_OPTS=-Xms256m -Xmx768m -Dfile.encoding=UTF-8 -XX:+UseG1GC